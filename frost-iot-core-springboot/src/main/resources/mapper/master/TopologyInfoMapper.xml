<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.footprintcat.frostiot.core.springboot.mapper.master.TopologyInfoMapper">

    <!-- 根据nodeId查询相邻上/下级并根据其相邻上/下级查询所有上/下级 -->
    <select id="selectAllSubsOrSupsByNodeId" resultType="com.footprintcat.frostiot.core.springboot.entity.TopologyInfo">
        WITH first_query AS (
            SELECT * FROM "public"."topology_runtime_info"
            WHERE node_id = #{nodeId} AND direction = #{direction}
        )
        SELECT * FROM first_query
        UNION ALL
        SELECT * FROM "public"."topology_runtime_info"
        WHERE node_id IN (SELECT target_node_id FROM first_query) AND direction = #{direction}
    </select>

</mapper>
